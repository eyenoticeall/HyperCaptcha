# Copy this file to `.env` (or a provider-specific `.env.*` file) and fill in
# your own credentials, then pass `--env-file .env` to `hypercaptcha serve`.
# Never commit real keys or tokens to version control.

# ---------------------------------------------------------------------------
# Google reCAPTCHA (classic v2/v3 SiteVerify, or pass --google-test-key
# for Google's public localhost test keys; defaults to --mode v2)
# ---------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google reCAPTCHA Enterprise (optional; used with --mode v2-enterprise,
# --mode v3-enterprise, or --mode policy-challenge)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_API_KEY=
# Or generate a short-lived token via: gcloud auth print-access-token
GOOGLE_CLOUD_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# hCaptcha (or pass --hcaptcha-test-key for hCaptcha's public publisher test
# keys; defaults to --captcha hcaptcha)
# ---------------------------------------------------------------------------
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Decision & Vision Model Providers
# ---------------------------------------------------------------------------

# vLLM Semantic Router / Decision API (default base URL: https://app.vllm-sr.ai/v1)
VLLM_SR_API_KEY=
# Optional comma-separated extra keys for parallel capacity
VLLM_SR_EXTRA_API_KEYS=
VLLM_SR_BASE_URL=

# Liquid Decision API (default base URL: https://api.liquid.ai/decisions/v1)
LIQUID_API_KEY=
LIQUID_BASE_URL=

# Typesafe Jev Decision API (default base URL: https://api.typesafe.ai/v1)
# TYPESAFE_API_KEY and TYPESAFE_BASE_URL are checked first, with optional
# fallback to JEV_API_KEY and JEV_BASE_URL.
TYPESAFE_API_KEY=
# JEV_API_KEY=
TYPESAFE_BASE_URL=
# JEV_BASE_URL=

# OpenAI-compatible Chat / Completions API (default base URL: https://api.openai.com/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
